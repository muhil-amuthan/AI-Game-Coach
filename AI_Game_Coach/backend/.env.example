# ==============================================================================
# AI Game Coach – Production & Development Environment Variables
# ==============================================================================
# In production on Render, set these variables in your Render Dashboard:
# Service -> Environment -> Add Environment Variable.
# For local development, copy this file to `.env` and fill in your values.
# ==============================================================================

# 1. Flask & JWT Security Keys (REQUIRED IN PRODUCTION)
# Generate random 32+ byte strings (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
JWT_SECRET_KEY=replace-with-another-secure-random-64-character-hex-string

# 2. Google Gemini API Key (OPTIONAL)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left unset, the backend falls back to built-in rule-based coaching.
GEMINI_API_KEY=

# 3. CORS / Allowed Frontend URLs
# Comma-separated list of allowed frontend origins (e.g., your Vercel URL and localhost)
# Example: https://ai-game-coach.vercel.app,http://localhost:3000,http://localhost:8080
CORS_ORIGINS=*
FRONTEND_URL=https://your-app-name.vercel.app

# 4. Database Storage Path (OPTIONAL)
# Path to SQLite database file. Default is `instance/ai_game_coach.db` inside backend directory.
DATABASE_PATH=instance/ai_game_coach.db

# 5. Server Port (OPTIONAL - Render automatically sets this)
PORT=5000

# 6. Environment Mode
FLASK_ENV=production
