{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/login",
      "dest": "/AI_Game_Coach/frontend/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/AI_Game_Coach/frontend/dashboard.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/AI_Game_Coach/frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(css|js|jpg|jpeg|png|svg|ico|json))",
      "dest": "/AI_Game_Coach/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/AI_Game_Coach/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/AI_Game_Coach/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
