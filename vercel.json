{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/AI_Game_Coach/frontend/index.html"
    },
    {
      "source": "/login",
      "destination": "/AI_Game_Coach/frontend/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/AI_Game_Coach/frontend/dashboard.html"
    },
    {
      "source": "/login.html",
      "destination": "/AI_Game_Coach/frontend/login.html"
    },
    {
      "source": "/dashboard.html",
      "destination": "/AI_Game_Coach/frontend/dashboard.html"
    },
    {
      "source": "/index.html",
      "destination": "/AI_Game_Coach/frontend/index.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/AI_Game_Coach/frontend/assets/$1"
    },
    {
      "source": "/(.*\\.(css|js|jpg|jpeg|png|svg|ico|json|woff|woff2|ttf))",
      "destination": "/AI_Game_Coach/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/AI_Game_Coach/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/AI_Game_Coach/frontend/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
